{
  "name": "@fixmate/server",
  "version": "1.0.0",
  "private": true,
  "description": "FixMate Express API with MongoDB, BetterAuth, JWT and Stripe",
  "scripts": {
    "dev": "nodemon -w src -x tsx --env-file .env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production tsx --env-file .env src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "type-check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "seed": "tsx --env-file .env src/seed/index.ts",
    "gen:api-types": "openapi-typescript ../docs/openapi.yaml -o src/generated/api/openapi.generated.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.27",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "stripe": "^23.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
