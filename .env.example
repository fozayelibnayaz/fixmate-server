# FixMate server configuration (copy to .env)
NODE_ENV=development
PORT=4000

# Public client origin (CORS + auth callbacks)
CLIENT_URL=http://localhost:3000
# Comma-separated additional allowed origins for production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MongoDB. For Atlas, use mongodb+srv://<user>:<password>@<cluster-host>/fixmate?retryWrites=true&w=majority
# The `fixmate` database is created on the first successful seed.
MONGODB_URI=mongodb://127.0.0.1:27017/fixmate

# BetterAuth
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Optional Google social login (Google users get the customer role by default).
# Leave the placeholders in place to keep the button hidden until real keys are pasted.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Authorized redirect URI (server origin):
# http://localhost:4000/api/auth/callback/google
# https://fixmate-server-flame.vercel.app/api/auth/callback/google

# JWT used by the custom Express role middleware
JWT_SECRET=replace-with-a-different-long-random-string
JWT_EXPIRES_IN=7d

# ImgBB image uploads
IMGBB_API_KEY=

# Stripe (test mode only)
STRIPE_SECRET_KEY=
# Local: stripe listen --forward-to localhost:4000/api/payments/webhook
# (copy the printed whsec_... value here). Production: use the signing secret
# from the Dashboard endpoint at https://<api-host>/api/payments/webhook.
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Seeded admin (never expose in production)
ADMIN_EMAIL=admin@fixmate.test
ADMIN_PASSWORD=ChangeMe123!
